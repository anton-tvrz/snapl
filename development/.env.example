# =============================================================================
# snapl — Development environment variables
# =============================================================================
# Copy to .env (or development/.env) and adjust as needed:
#   cp development/.env.example development/.env

# ---------------------------------------------------------------------------
# Infrahub — Source of Truth
# ---------------------------------------------------------------------------
# INFRAHUB_ADDRESS and INFRAHUB_API_TOKEN are the names expected by the
# infrahub-sdk Python client. The token is a local-dev value; generate a
# fresh one in the Infrahub UI (Profile -> API tokens) for non-default setups.
INFRAHUB_ADDRESS=http://localhost:8000
INFRAHUB_API_TOKEN=06438eb2-8019-4776-878c-0941b1f1d1ec

# ---------------------------------------------------------------------------
# Temporal — workflow engine for the orchestrator
# ---------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
# Durable audit log. Point it somewhere persistent — /tmp is cleared on reboot.
SNAPL_AUDIT_DB=./snapl-audit.sqlite

# ---------------------------------------------------------------------------
# SR Linux — containerlab node credentials (lab defaults; gNMI is plaintext)
# ---------------------------------------------------------------------------
SRLINUX_USERNAME=admin
SRLINUX_PASSWORD=NokiaSrl1!  # pragma: allowlist secret
SRLINUX_PORT=57400

# ---------------------------------------------------------------------------
# Neo4j (Infrahub's backing graph database)
# ---------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASS=infrahub

# ---------------------------------------------------------------------------
# RabbitMQ (Infrahub's message queue)
# ---------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---------------------------------------------------------------------------
# Docker Compose port overrides (optional)
# ---------------------------------------------------------------------------
# Uncomment the block below to offset every host port by +1, so the snapl stack
# can run alongside another project's. If you do, also set INFRAHUB_ADDRESS and
# TEMPORAL_HOST above to match — they are what the worker and the demo tasks
# read, and a mismatch means seeding one Infrahub while querying another.
# INFRAHUB_PORT=8001
# TEMPORAL_PORT=7234
# NEO4J_BOLT_PORT=7688
# NEO4J_HTTP_PORT=7475
# REDIS_PORT=6380
# RABBITMQ_PORT=5673
# RABBITMQ_MGMT_PORT=15673
# PREFECT_PORT=4201

# =============================================================================
# Service URLs (quick reference)
# =============================================================================
# Infrahub UI + API:      http://localhost:8000
# Infrahub GraphQL:       http://localhost:8000/graphql
# Neo4j Browser:          http://localhost:7474
# RabbitMQ Management:    http://localhost:15672
# Prefect UI:             http://localhost:4200
