# =============================================================================
# snapl — Development environment variables
# =============================================================================
# Copy to .env (or development/.env) and adjust as needed:
#   cp development/.env.example development/.env

# ---------------------------------------------------------------------------
# Infrahub — Source of Truth
# ---------------------------------------------------------------------------
# INFRAHUB_ADDRESS and INFRAHUB_API_TOKEN are the names expected by the
# infrahub-sdk Python client. The token is a local-dev value; generate a
# fresh one in the Infrahub UI (Profile -> API tokens) for non-default setups.
INFRAHUB_ADDRESS=http://localhost:18000
INFRAHUB_API_TOKEN=1ad8b66d-cca3-4523-821c-52c3d7e69100

# ---------------------------------------------------------------------------
# Temporal — workflow engine for the orchestrator
# ---------------------------------------------------------------------------
TEMPORAL_HOST=localhost:18033
# Durable audit log. Point it somewhere persistent — /tmp is cleared on reboot.
SNAPL_AUDIT_DB=./snapl-audit.sqlite

# ---------------------------------------------------------------------------
# SR Linux — containerlab node credentials (lab defaults; gNMI is plaintext)
# ---------------------------------------------------------------------------
SRLINUX_USERNAME=admin
SRLINUX_PASSWORD=NokiaSrl1!  # pragma: allowlist secret
SRLINUX_PORT=57400

# ---------------------------------------------------------------------------
# Neo4j (Infrahub's backing graph database)
# ---------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASS=infrahub

# ---------------------------------------------------------------------------
# RabbitMQ (Infrahub's message queue)
# ---------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---------------------------------------------------------------------------
# Docker Compose port overrides (optional)
# ---------------------------------------------------------------------------
# snapl owns the 18000-18099 port block and binds NO conventional default
# (Issue #107). You should not need to change these: the whole point of the
# block is that a fresh clone does not collide with any other project's stack.
# Do NOT "fix" a collision by adding 1 — 8001 belongs to synapse-gcp-base.
# If you do move a port, update INFRAHUB_ADDRESS / TEMPORAL_HOST above to match
# and add it to dev/knowledge/host-resource-registry.md.
# INFRAHUB_PORT=18000
# TEMPORAL_PORT=18033
# TEMPORAL_UI_PORT=18034
# NEO4J_BOLT_PORT=18087
# NEO4J_HTTP_PORT=18074
# REDIS_PORT=18079
# RABBITMQ_PORT=18072
# RABBITMQ_MGMT_PORT=18015
# PREFECT_PORT=18042

# =============================================================================
# Service URLs (quick reference)
# =============================================================================
# Infrahub UI + API:      http://localhost:18000
# Infrahub GraphQL:       http://localhost:18000/graphql
# Neo4j Browser:          http://localhost:18074
# RabbitMQ Management:    http://localhost:18015
# Prefect UI:             http://localhost:18042
# Temporal Web UI:        http://localhost:18034
