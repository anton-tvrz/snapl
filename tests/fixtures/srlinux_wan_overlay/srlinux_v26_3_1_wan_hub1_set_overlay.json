{
  "interface": [
    {
      "name": "ethernet-1/1",
      "admin-state": "enable",
      "description": "underlay mpls",
      "subinterface": [
        {
          "index": 0,
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "10.255.1.0/31"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ethernet-1/2",
      "admin-state": "enable",
      "description": "underlay isp",
      "subinterface": [
        {
          "index": 0,
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "198.51.100.0/31"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ethernet-1/3",
      "admin-state": "enable",
      "description": "site LAN",
      "subinterface": [
        {
          "index": 0,
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "10.1.0.1/24"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "system0",
      "admin-state": "enable",
      "subinterface": [
        {
          "index": 0,
          "admin-state": "enable",
          "ipv4": {
            "admin-state": "enable",
            "address": [
              {
                "ip-prefix": "10.254.0.1/32"
              }
            ]
          }
        }
      ]
    }
  ],
  "tunnel-interface": [
    {
      "name": "vxlan1",
      "vxlan-interface": [
        {
          "index": 100,
          "type": "routed",
          "ingress": {
            "vni": 100
          }
        }
      ]
    }
  ],
  "bfd": {
    "subinterface": [
      {
        "id": "ethernet-1/1.0",
        "admin-state": "enable",
        "desired-minimum-transmit-interval": 100000,
        "required-minimum-receive": 100000,
        "detection-multiplier": 3
      },
      {
        "id": "ethernet-1/2.0",
        "admin-state": "enable",
        "desired-minimum-transmit-interval": 100000,
        "required-minimum-receive": 100000,
        "detection-multiplier": 3
      }
    ]
  },
  "routing-policy": {
    "prefix-set": [
      {
        "name": "system-loopbacks",
        "prefix": [
          {
            "ip-prefix": "10.254.0.0/24",
            "mask-length-range": "32..32"
          }
        ]
      }
    ],
    "policy": [
      {
        "name": "export-loopbacks",
        "statement": [
          {
            "name": "10",
            "match": {
              "prefix": {
                "prefix-set": "system-loopbacks"
              }
            },
            "action": {
              "policy-result": "accept"
            }
          }
        ],
        "default-action": {
          "policy-result": "reject"
        }
      },
      {
        "name": "mpls-in",
        "statement": [
          {
            "name": "10",
            "match": {
              "prefix": {
                "prefix-set": "system-loopbacks"
              }
            },
            "action": {
              "policy-result": "accept",
              "bgp": {
                "local-preference": {
                  "operation": "set",
                  "value": 200
                }
              }
            }
          }
        ],
        "default-action": {
          "policy-result": "reject"
        }
      },
      {
        "name": "isp-in",
        "statement": [
          {
            "name": "10",
            "match": {
              "prefix": {
                "prefix-set": "system-loopbacks"
              }
            },
            "action": {
              "policy-result": "accept",
              "bgp": {
                "local-preference": {
                  "operation": "set",
                  "value": 50
                }
              }
            }
          }
        ],
        "default-action": {
          "policy-result": "reject"
        }
      }
    ]
  },
  "network-instance": [
    {
      "name": "default",
      "interface": [
        {
          "name": "ethernet-1/1.0"
        },
        {
          "name": "ethernet-1/2.0"
        },
        {
          "name": "system0.0"
        }
      ],
      "protocols": {
        "bgp": {
          "admin-state": "enable",
          "autonomous-system": 65000,
          "router-id": "10.254.0.1",
          "afi-safi": [
            {
              "afi-safi-name": "ipv4-unicast",
              "admin-state": "enable"
            },
            {
              "afi-safi-name": "evpn",
              "admin-state": "enable"
            }
          ],
          "group": [
            {
              "group-name": "underlay-mpls",
              "admin-state": "enable",
              "import-policy": [
                "mpls-in"
              ],
              "export-policy": [
                "export-loopbacks"
              ],
              "failure-detection": {
                "enable-bfd": true,
                "fast-failover": true
              },
              "afi-safi": [
                {
                  "afi-safi-name": "ipv4-unicast",
                  "admin-state": "enable"
                },
                {
                  "afi-safi-name": "evpn",
                  "admin-state": "disable"
                }
              ]
            },
            {
              "group-name": "underlay-isp",
              "admin-state": "enable",
              "import-policy": [
                "isp-in"
              ],
              "export-policy": [
                "export-loopbacks"
              ],
              "failure-detection": {
                "enable-bfd": true,
                "fast-failover": true
              },
              "afi-safi": [
                {
                  "afi-safi-name": "ipv4-unicast",
                  "admin-state": "enable"
                },
                {
                  "afi-safi-name": "evpn",
                  "admin-state": "disable"
                }
              ]
            },
            {
              "group-name": "overlay",
              "admin-state": "enable",
              "peer-as": 65500,
              "local-as": {
                "as-number": 65500
              },
              "transport": {
                "local-address": "10.254.0.1"
              },
              "afi-safi": [
                {
                  "afi-safi-name": "ipv4-unicast",
                  "admin-state": "disable"
                },
                {
                  "afi-safi-name": "evpn",
                  "admin-state": "enable"
                }
              ]
            }
          ],
          "neighbor": [
            {
              "peer-address": "10.255.1.1",
              "peer-as": 65011,
              "peer-group": "underlay-mpls",
              "admin-state": "enable"
            },
            {
              "peer-address": "198.51.100.1",
              "peer-as": 65011,
              "peer-group": "underlay-isp",
              "admin-state": "enable"
            },
            {
              "peer-address": "10.254.0.11",
              "peer-group": "overlay",
              "admin-state": "enable"
            }
          ]
        }
      }
    },
    {
      "name": "corp",
      "type": "ip-vrf",
      "admin-state": "enable",
      "interface": [
        {
          "name": "ethernet-1/3.0"
        }
      ],
      "vxlan-interface": [
        {
          "name": "vxlan1.100"
        }
      ],
      "protocols": {
        "bgp-evpn": {
          "bgp-instance": [
            {
              "id": 1,
              "admin-state": "enable",
              "vxlan-interface": "vxlan1.100",
              "evi": 100
            }
          ]
        },
        "bgp-vpn": {
          "bgp-instance": [
            {
              "id": 1,
              "route-target": {
                "export-rt": "target:65500:100",
                "import-rt": "target:65500:100"
              }
            }
          ]
        }
      }
    }
  ]
}
