  "paths": {
    "/api/v1/devices": {
      "get": {
        "operationId": "devices_api_v1_devices_get",
        "parameters": [
          {
            "description": "Defaults to the server's --use-case.",
            "in": "query",
            "name": "use_case",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the server's --use-case.",
              "title": "Use Case"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Devices"
      }
    },
