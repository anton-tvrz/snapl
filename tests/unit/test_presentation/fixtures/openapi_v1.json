{
  "components": {
    "schemas": {
      "DeployOutcome": {
        "additionalProperties": false,
        "properties": {
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkflowReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "workflow_id": {
            "title": "Workflow Id",
            "type": "string"
          }
        },
        "required": [
          "workflow_id",
          "success",
          "ended_at"
        ],
        "title": "DeployOutcome",
        "type": "object"
      },
      "DeviceView": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "drift_state": {
            "$ref": "#/components/schemas/DriftState"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "in_intent": {
            "title": "In Intent",
            "type": "boolean"
          },
          "last_deploy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeployOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_scan_workflow_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Scan Workflow Id"
          },
          "last_scanned_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Scanned At"
          },
          "missing_paths": {
            "items": {
              "type": "string"
            },
            "title": "Missing Paths",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "suggested_command": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Command"
          },
          "unclassified_paths": {
            "items": {
              "type": "string"
            },
            "title": "Unclassified Paths",
            "type": "array"
          },
          "undesired_paths": {
            "items": {
              "type": "string"
            },
            "title": "Undesired Paths",
            "type": "array"
          }
        },
        "required": [
          "device_id",
          "name",
          "role",
          "in_intent",
          "drift_state"
        ],
        "title": "DeviceView",
        "type": "object"
      },
      "DevicesResponse": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "1",
            "default": "1",
            "title": "Contract Version",
            "type": "string"
          },
          "devices": {
            "$ref": "#/components/schemas/View_list_DeviceView__"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "use_case": {
            "title": "Use Case",
            "type": "string"
          }
        },
        "required": [
          "use_case",
          "generated_at",
          "devices"
        ],
        "title": "DevicesResponse",
        "type": "object"
      },
      "DriftState": {
        "enum": [
          "in_sync",
          "missing",
          "undesired",
          "missing_and_undesired",
          "drifted",
          "error",
          "never_scanned"
        ],
        "title": "DriftState",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SourceName": {
        "enum": [
          "audit",
          "temporal",
          "sot",
          "ci",
          "lab_runs"
        ],
        "title": "SourceName",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "View_list_DeviceView__": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "data": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DeviceView"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "fetched_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fetched At"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "remedy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remedy"
          },
          "source": {
            "$ref": "#/components/schemas/SourceName"
          },
          "stale": {
            "default": false,
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "available"
        ],
        "title": "View[list[DeviceView]]",
        "type": "object"
      },
      "WorkflowReason": {
        "description": "Terminal reason codes for any WorkflowResult.",
        "enum": [
          "succeeded",
          "intent_unavailable",
          "apply_failed",
          "collect_failed",
          "verification_failed",
          "audit_failed",
          "cancelled",
          "device_not_found",
          "remediation_failed"
        ],
        "title": "WorkflowReason",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "snapl dashboard",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/devices": {
      "get": {
        "operationId": "devices_api_v1_devices_get",
        "parameters": [
          {
            "description": "Defaults to the server's --use-case.",
            "in": "query",
            "name": "use_case",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the server's --use-case.",
              "title": "Use Case"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Devices"
      }
    }
  }
}
