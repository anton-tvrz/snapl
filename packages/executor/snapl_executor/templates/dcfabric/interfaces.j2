[
{% for iface in interfaces %}
  {
    "name": "{{ iface.name }}",
    "admin-state": "{{ 'enable' if iface.enabled else 'disable' }}",
    "mtu": {{ iface.mtu }}{% if iface.description %},
    "description": {{ iface.description | tojson }}{% endif %}{% if iface.ip_address %},
    "subinterface": [
      {
        "index": 0,
        "admin-state": "enable",
        "ipv4": {
          "admin-state": "enable",
          "address": [
            {
              "ip-prefix": "{{ iface.ip_address }}/{{ iface.prefix_length }}"
            }
          ]
        }
      }
    ]{% endif %}
  }{% if not loop.last %},{% endif %}
{% endfor %}
]
